            mode: "incongruent"
        }
    ];

    // =========================================================
    // 3. UNIQUE ANONYMOUS PARTICIPANT ID
    // =========================================================
    function getOrCreateParticipantId() {
        let pid = sessionStorage.getItem('stroop_pid');
        if (!pid) {
            const dateStr = new Date().toISOString().slice(0, 10).replace(/-/g, '');
            const randStr = Math.random().toString(36).substring(2, 7).toUpperCase();
            pid = `P-${dateStr}-${randStr}`;
            sessionStorage.setItem('stroop_pid', pid);
        }
        return pid;
    }

    const participantId = getOrCreateParticipantId();
    document.getElementById('start-id-display').innerText = participantId;

